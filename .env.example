# Copy to .env (local) or set as GitHub repo Variables (deploy). All optional.

# FormSubmit alias (random string FormSubmit gives after first activation).
# When set, the contact form posts to https://formsubmit.co/ajax/<id> and your email stays hidden.
REACT_APP_FORMSUBMIT_ID=

# Plausible analytics domain, e.g. hunexture.com (takes priority over GA4)
REACT_APP_PLAUSIBLE_DOMAIN=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
REACT_APP_GA_ID=
